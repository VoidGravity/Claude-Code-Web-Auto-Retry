{
  "manifest_version": 3,
  "name": "Claude Code Web Auto-Retry",
  "version": "1.0.0",
  "description": "Automatically retries Claude Code web sessions when account usage resets.",
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "host_permissions": ["https://claude.ai/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude Code Web Auto-Retry"
  }
}
